# devbox stack configuration — one stack per customer.
#
# Deploy this git repo as a separate Portainer stack for each customer and set
# these under Stacks → <stack> → Environment variables. INSTANCE, SSH_PORT and
# CODE_PORT MUST be unique across stacks (they share the host namespace).
#
# Claude and Codex use YOUR subscriptions via interactive login: run `claude`
# / `codex` once inside the container and complete the browser auth. The login
# persists in that stack's `home` volume (along with `gh` and all other per-tool
# state), so every customer stays isolated. No API keys required.

# Unique name → container_name + hostname. Use the customer's short name.
INSTANCE=acme

# Host ports. Pick a distinct set per customer, e.g.:
#   acme     SSH_PORT=2222  CODE_PORT=8443  DEV_PORT=8081
#   globex   SSH_PORT=2223  CODE_PORT=8444  DEV_PORT=8082
#   initech  SSH_PORT=2224  CODE_PORT=8445  DEV_PORT=8083
#   umbrella SSH_PORT=2225  CODE_PORT=8446  DEV_PORT=8084
SSH_PORT=2222
CODE_PORT=8443

# App dev server port (Vite/Next/etc), published as-is so the app is reachable
# at http://solstice.local:${DEV_PORT} from any device on the network. Your dev
# server MUST bind 0.0.0.0 (e.g. Vite server.host: true) and listen on this
# port — read it in the app via process.env.DEV_PORT.
DEV_PORT=8081

# Your laptop's SSH public key (the whole single line). Injected into the dev
# user's authorized_keys on every start. Connect with:
#   ssh dev@solstice.local -p ${SSH_PORT}
SSH_PUBKEY=ssh-ed25519 AAAA...replace-me... you@laptop

# Optional second public key (e.g. another machine), appended after SSH_PUBKEY.
# authorized_keys is rewritten from these vars on every start — keys added by
# hand inside the container are wiped; add them here instead.
#SSH_PUBKEY2=ssh-ed25519 AAAA...replace-me... you@desktop

# CLI freshness cache-bust. The baked-in CLIs (claude, codex, gh, …) install
# "latest" at build time, but Docker's layer cache pins whatever was built
# last. Bump this to any new value (e.g. 2026-07-05) and redeploy with
# re-build to force fresh installs.
CLI_REFRESH=0

# Isolation note: these are containers on a shared host kernel/daemon, and the
# `dev` user has passwordless sudo. A stack isolates code and Claude/Codex
# accounts between YOUR customers, but it is not a hardened boundary against a
# malicious occupant of a container.
